		{
			"name": "4. Customer Add Fund & Bonus",
			"item": [
				{
					"name": "4.1 Get Active Wallet Bonus List",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/customer/bonus-list?limit=10&offset=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"customer",
								"bonus-list"
							],
							"query": [
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "offset",
									"value": "1"
								}
							]
						},
						"description": "Fetches active add-fund bonus offers available for the customer to get extra wallet rewards upon adding funds."
					},
					"response": []
				},
				{
					"name": "4.2 Initiate Add Fund (Payment Gateway URL)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/payment?access_token={{base64_customer_user_id}}&amount=500&is_add_fund=1&payment_method=razorpay&payment_platform=app&callback=http://localhost/mmc/payment-success",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"payment"
							],
							"query": [
								{
									"key": "access_token",
									"value": "{{base64_customer_user_id}}",
									"description": "Base64 encoded customer user UUID"
								},
								{
									"key": "amount",
									"value": "500",
									"description": "Amount to add to wallet"
								},
								{
									"key": "is_add_fund",
									"value": "1",
									"description": "Must be 1 for wallet deposit"
								},
								{
									"key": "payment_method",
									"value": "razorpay",
									"description": "Selected gateway: razorpay, stripe, ssl_commerz, paystack, etc."
								},
								{
									"key": "payment_platform",
									"value": "app",
									"description": "app or web"
								},
								{
									"key": "callback",
									"value": "http://localhost/mmc/payment-success",
									"description": "Redirect url after payment"
								}
							]
						},
						"description": "Web payment flow for adding funds to customer wallet. When payment completes, add_fund_success hook executes addFundTransactions to update wallet."
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Booking Payment via Wallet",
			"item": [
				{
					"name": "5.1 Place Booking using Wallet Payment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"payment_method\": \"wallet_payment\",\n    \"zone_id\": \"{{sample_zone_id}}\",\n    \"service_schedule\": \"2026-11-20 14:00:00\",\n    \"service_address_id\": \"{{sample_address_id}}\",\n    \"is_partial\": 0\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/customer/booking/request/send",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"customer",
								"booking",
								"request",
								"send"
							]
						},
						"description": "Places a service booking directly paying through customer wallet balance. If wallet_balance >= total_booking_amount, payment succeeds and amount is deducted."
					},
					"response": []
				}
			]
		},
