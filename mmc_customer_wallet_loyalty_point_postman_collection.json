		{
			"name": "2. Customer Loyalty Points",
			"item": [
				{
					"name": "2.1 Get Loyalty Points Transaction History",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/customer/loyalty-point-transaction?limit=10&offset=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"customer",
								"loyalty-point-transaction"
							],
							"query": [
								{
									"key": "limit",
									"value": "10",
									"description": "Records per page"
								},
								{
									"key": "offset",
									"value": "1",
									"description": "Page offset index"
								}
							]
						},
						"description": "Fetches loyalty points history (Earned from bookings, Debited on transfer to wallet). Also returns:\n- loyalty_point\n- loyalty_point_value_per_currency_unit\n- min_loyalty_point_to_transfer"
					},
					"response": []
				},
				{
					"name": "2.2 Convert / Transfer Loyalty Points to Wallet",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"point\": 50\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/customer/loyalty-point/wallet-transfer",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"customer",
								"loyalty-point",
								"wallet-transfer"
							]
						},
						"description": "Converts customer loyalty points into wallet money. Point amount must be >= min_loyalty_point_to_transfer and <= customer's current points. Conversion formula: wallet_amount = point / loyalty_point_value_per_currency_unit."
					},
					"response": []
				}
			]
		},
